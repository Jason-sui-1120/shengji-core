{
  "$schema": "api-contract/v1",
  "description": "双端共同业务 API 契约。契约测试以真实服务校验：方法/路径/状态码/必填字段/字段类型。差异仅允许 api-profile-exceptions.json 登记项。",
  "apis": [
    {
      "method": "GET",
      "path": "/api/health",
      "status": 200,
      "requiredFields": {
        "ok": "boolean",
        "coreVersion": "string",
        "deploymentProfile": "string",
        "effectiveModels": "object"
      }
    },
    {
      "method": "GET",
      "path": "/api/state",
      "status": 200,
      "requiredFields": {
        "projects": "array",
        "meeting": "object",
        "transcripts": "array",
        "summaryBlocks": "array",
        "actions": "array"
      },
      "auth": "company"
    },
    {
      "method": "GET",
      "path": "/api/asr/models",
      "status": 200,
      "requiredFields": {
        "models": "array"
      }
    },
    {
      "method": "POST",
      "path": "/api/projects",
      "body": {
        "name": "契约测试项目"
      },
      "status": 201,
      "requiredFields": {
        "ok": "boolean",
        "project": "object"
      },
      "auth": "company"
    },
    {
      "method": "POST",
      "path": "/api/meetings",
      "body": {
        "projectId": 1,
        "title": "契约测试会议"
      },
      "status": 201,
      "requiredFields": {},
      "auth": "company"
    },
    {
      "method": "POST",
      "path": "/api/glossary",
      "body": {
        "term": "契约热词",
        "aliases": [
          "热词"
        ]
      },
      "status": 200,
      "requiredFields": {
        "glossaryEntries": "array"
      },
      "auth": "company"
    },
    {
      "method": "POST",
      "path": "/api/actions",
      "body": {
        "meetingId": 1,
        "title": "契约待办",
        "owner": "张三"
      },
      "status": 200,
      "requiredFields": {},
      "auth": "company"
    },
    {
      "method": "POST",
      "path": "/api/summary-blocks",
      "body": {
        "meetingId": 1,
        "title": "契约议题",
        "items": [
          "议题1"
        ]
      },
      "status": 200,
      "requiredFields": {
        "ok": "boolean"
      },
      "auth": "company"
    },
    {
      "method": "POST",
      "path": "/api/transcripts",
      "body": {
        "meetingId": 1,
        "text": "契约转写",
        "speaker": "说话人1",
        "time": "00:00:05",
        "audioStartMs": 0,
        "audioEndMs": 5000
      },
      "status": 200,
      "requiredFields": {},
      "auth": "company"
    },
    {
      "method": "PATCH",
      "path": "/api/actions/1",
      "body": {
        "status": "done"
      },
      "status": 200,
      "requiredFields": {},
      "auth": "company"
    },
    {
      "method": "DELETE",
      "path": "/api/actions/1",
      "status": 200,
      "requiredFields": {},
      "auth": "company"
    },
    {
      "method": "POST",
      "path": "/api/actions/1/restore",
      "status": 200,
      "requiredFields": {},
      "auth": "company"
    },
    {
      "method": "PATCH",
      "path": "/api/speakers/rename",
      "body": {
        "meetingId": 1,
        "from": "说话人1",
        "to": "李四"
      },
      "status": [
        200,
        400,
        404
      ],
      "requiredFields": {},
      "auth": "company"
    },
    {
      "method": "GET",
      "path": "/api/search/transcripts?q=契约",
      "status": 200,
      "requiredFields": {},
      "auth": "company"
    },
    {
      "method": "GET",
      "path": "/api/trash",
      "status": 200,
      "requiredFields": {},
      "auth": "company"
    },
    {
      "method": "GET",
      "path": "/api/meeting-segments?meetingId=1",
      "status": 200,
      "requiredFields": {},
      "auth": "company"
    },
    {
      "method": "GET",
      "path": "/api/meetings/finalization-status?meetingId=1",
      "status": 200,
      "requiredFields": {},
      "auth": "company"
    },
    {
      "method": "POST",
      "path": "/api/meetings/finalize",
      "body": {
        "meetingId": 1
      },
      "status": [
        200,
        400,
        404,
        409
      ],
      "requiredFields": {},
      "auth": "company"
    },
    {
      "method": "POST",
      "path": "/api/meetings/finalize-draft",
      "body": {
        "meetingId": 1
      },
      "status": [
        200,
        202,
        400,
        404,
        409
      ],
      "requiredFields": {},
      "auth": "company"
    },
    {
      "method": "GET",
      "path": "/api/meetings/finalize-draft/status?meetingId=1",
      "status": [
        200,
        404
      ],
      "requiredFields": {},
      "auth": "company"
    }
  ],
  "notes": {
    "optional": "optional=true 表示该接口允许路径形式差异（query/路径参数），契约测试仅校验存在性与基本结构",
    "auth": "auth=company 表示公司端需登录态（契约测试用 mock 登录），公网端裸调"
  }
}